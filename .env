NODE_ENV=development
PORT=3000
API_PREFIX=api
APP_NAME=Pkg forms Updated

DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=pkg_forms_updated_1790588323

DB_SYNCHRONIZE=true
DB_LOGGING=true

QUEUE_REDIS_HOST=redis
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_DB=0

# S3-compatible storage (MinIO when running compose). The generated docker-compose.yml
# overrides endpoint and bucket-related values for the app container when using service hostnames.
AWS_S3_ENDPOINT=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
FILE_MANAGEMENT_BUCKET_NAME=vyapti-be
FILE_STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:${PORT_minio_9000:-9000}/vyapti-be

# Monorepo root containing the `generated/` output directory. Docker Compose sets this to /workspace; leave unset locally to use process.cwd() (run commands from the generated app directory).
# VYAPTI_REPO_ROOT=

